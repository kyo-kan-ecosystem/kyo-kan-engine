{
    "include": [
        "src/**/*",
        "void/void.ts",
        "interfacade/**/*",
    ],
    "compilerOptions": {
        "lib": [
            "esnext"
        ],
        "allowJs": true,
        "declaration": true,
        "emitDeclarationOnly": true,
        "incremental": true,
        "checkJs": true,
        "strict": true,
        "module": "commonjs",
        "types": [
            "node",
            "mocha",
            "chai"
        ],
        "preserveSymlinks": true
    },
}